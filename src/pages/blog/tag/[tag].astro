---
import BlogCard from '../../../components/BlogCard.astro';
import TagFilter from '../../../components/TagFilter.astro';
import Layout from '../../../layouts/Layout.astro';
import { getPublishedPosts, getTagCounts, type BlogPost, type TagCount } from '../../../utils/blog';

interface Props {
  posts: BlogPost[];
  tags: TagCount[];
  total: number;
}

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getTagCounts(posts);
  return tags.map(({ tag }) => ({
    params: { tag },
    props: {
      posts: posts.filter((post) => post.data.tags.includes(tag)),
      tags,
      total: posts.length,
    },
  }));
}

const { tag } = Astro.params;
const { posts, tags, total } = Astro.props;
---

<Layout
  title={`${tag} · Blog · Camille Islasse`}
  description={`Articles tagués « ${tag} » sur le blog de Camille Islasse : Symfony, Sylius et intégration IA.`}
  noindex
>
  <h1 class="mb-6 text-4xl">Blog</h1>
  <TagFilter tags={tags} total={total} active={tag} />
  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    {
      posts.map((post) => (
        <li>
          <BlogCard post={post} />
        </li>
      ))
    }
  </ul>
</Layout>
