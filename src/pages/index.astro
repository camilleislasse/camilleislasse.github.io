---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import GitGraph from '../components/GitGraph.astro';
import PostCarousel from '../components/PostCarousel.astro';
import Layout from '../layouts/Layout.astro';
import portrait from '../assets/camille.png';
import { certifications, cvEntries, profile } from '../data/cv';
import { site } from '../data/site';
import { getPublishedPosts } from '../utils/blog';

const posts = await getPublishedPosts();
---

<Layout
  title="Camille Islasse · Développeur Symfony & Sylius"
  description="Camille Islasse, développeur Symfony & Sylius : e-commerce sur mesure, connecteurs ERP/CRM/PIM et contributions open source à Sylius et Symfony AI."
>
  <section class="grid gap-10 pt-6 pb-20 sm:grid-cols-[1fr_auto] sm:items-end sm:gap-14">
    <div>
      <h1 class="text-4xl md:text-5xl">{profile.role}</h1>
      <p class="mt-5 max-w-xl text-lg text-ink-2">{profile.tagline}</p>
      <p class="mt-3 max-w-xl text-sm text-muted">{profile.current}</p>
      <ul class="mt-7 flex flex-wrap items-center gap-5">
        {
          profile.links.map((link) => (
            <li>
              <a
                class="block text-ink transition-colors hover:text-accent"
                href={link.href}
                aria-label={link.label}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'noopener' : undefined}
              >
                <Icon name={link.icon} size={24} />
              </a>
            </li>
          ))
        }
        <li>
          <a
            class="border-b border-line-strong pb-0.5 text-sm transition-colors hover:border-accent hover:text-accent"
            href={`mailto:${site.email}`}>{site.email}</a
          >
        </li>
        <li>
          <a
            class="border-b border-line-strong pb-0.5 text-sm transition-colors hover:border-accent hover:text-accent"
            href="/cv-camille-islasse.pdf"
            download>CV (PDF)</a
          >
        </li>
      </ul>
    </div>

    <Image
      class="w-40 justify-self-start border border-line sm:w-52 sm:justify-self-end"
      src={portrait}
      alt="Camille Islasse à son poste de travail"
      widths={[160, 208, 416]}
      sizes="(max-width: 640px) 160px, 208px"
      loading="eager"
    />
  </section>

  <section
    id="parcours"
    class="mx-[calc(50%-50vw)] w-screen bg-cream-2"
    style="--graph-bg: var(--color-cream-2)"
  >
    <div class="mx-auto max-w-5xl px-6 py-16">
      <h2 class="mb-10 text-2xl">Parcours & open source</h2>
      <GitGraph entries={cvEntries} />
    </div>
  </section>

  <section class="py-12">
    <h2 class="mb-6 text-center text-2xl sm:text-left">Derniers articles</h2>
    <PostCarousel posts={posts} />
    <div class="mt-8 text-center">
      <a
        class="inline-block rounded-full bg-ink px-7 py-3.5 font-display font-bold text-cream"
        href="/blog/">Voir tous les articles</a
      >
    </div>
  </section>

  <section class="mx-[calc(50%-50vw)] -mb-24 w-screen bg-cream-2">
    <div class="mx-auto max-w-5xl px-6 py-14">
      <h2 class="mb-6 text-2xl">Certifications</h2>
      <ul class="flex flex-wrap gap-2.5">
        {
          certifications.map((certif) => (
            <li>
              {certif.href ? (
                <a
                  class="inline-block rounded-md border border-line px-3 py-1.5 text-[13px] text-ink-2 transition-colors hover:border-ink"
                  href={certif.href}
                  target="_blank"
                  rel="noopener"
                >
                  <strong class="font-semibold">{certif.issuer}</strong> · {certif.title}
                </a>
              ) : (
                <span class="inline-block rounded-md border border-line px-3 py-1.5 text-[13px] text-ink-2">
                  <strong class="font-semibold">{certif.issuer}</strong> · {certif.title}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
