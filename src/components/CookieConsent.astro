---
import { site } from '../data/site';
---

<!-- Bandeau de première visite -->
<div
  id="cookie-banner"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-cream"
  hidden
>
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-6 py-5">
    <p class="max-w-prose text-sm text-ink-2">
      Ce site utilise Google Analytics pour mesurer son audience. Vous pouvez accepter ou
      refuser, et changer d'avis à tout moment via le lien «&nbsp;Cookies&nbsp;».
    </p>
    <div class="flex flex-wrap gap-3">
      <button
        class="border border-ink bg-ink px-5 py-2.5 text-sm font-semibold text-cream"
        data-cookie-accept>Tout accepter</button
      >
      <button
        class="border border-ink px-5 py-2.5 text-sm font-semibold"
        data-cookie-refuse>Tout refuser</button
      >
      <button class="px-2 py-2.5 text-sm font-semibold underline underline-offset-4" data-cookie-open
        >Personnaliser</button
      >
    </div>
  </div>
</div>

<!-- Modale de gestion -->
<dialog
  id="cookie-dialog"
  class="m-auto w-full max-w-lg border border-ink bg-cream text-ink backdrop:bg-ink/70"
  aria-labelledby="cookie-dialog-title"
>
  <header class="flex items-start justify-between gap-4 border-b border-line p-6">
    <h2 id="cookie-dialog-title" class="text-xl">Cookies</h2>
    <button class="-m-2 p-2" data-cookie-close aria-label="Fermer">
      <svg class="size-5 fill-none stroke-current stroke-2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </header>

  <div class="p-6">
    <p class="text-sm text-muted">
      Votre consentement s'applique aux services ci-dessous. Il est conservé 6 mois et
      modifiable à tout moment. <a
        class="text-ink underline underline-offset-4"
        href="/mentions-legales/">Politique de confidentialité</a
      >
    </p>

    <ul class="mt-6">
      <li class="flex items-center justify-between gap-4 border-t border-line py-4">
        <div>
          <p class="text-sm font-semibold">Cookies essentiels</p>
          <p class="text-sm text-muted">Fonctionnement du site.</p>
        </div>
        <span class="font-mono text-xs text-muted">Toujours actifs</span>
      </li>
      <li class="flex flex-wrap items-center justify-between gap-4 border-t border-line py-4">
        <div>
          <p class="text-sm font-semibold">Google Analytics (GA4)</p>
          <p class="text-sm text-muted">Mesure d'audience.</p>
        </div>
        <div class="flex gap-2" role="group" aria-label="Google Analytics">
          <button
            class="border border-ink px-4 py-2 text-sm font-semibold aria-pressed:bg-ink aria-pressed:text-cream"
            data-cookie-choice="granted"
            aria-pressed="false">Autoriser</button
          >
          <button
            class="border border-ink px-4 py-2 text-sm font-semibold aria-pressed:bg-ink aria-pressed:text-cream"
            data-cookie-choice="denied"
            aria-pressed="false">Refuser</button
          >
        </div>
      </li>
    </ul>
  </div>

  <footer class="flex justify-end border-t border-line p-6">
    <button
      class="border border-ink bg-ink px-5 py-2.5 text-sm font-semibold text-cream"
      data-cookie-save>Enregistrer</button
    >
  </footer>
</dialog>

<script is:inline define:vars={{ gtagId: site.gtagId }}>
  const KEY = 'camilleislasse-consent';
  const banner = document.getElementById('cookie-banner');
  const dialog = document.getElementById('cookie-dialog');
  const choices = dialog.querySelectorAll('[data-cookie-choice]');

  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }

  gtag('consent', 'default', {
    analytics_storage: 'denied',
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
  });

  const read = () => {
    try {
      return JSON.parse(localStorage.getItem(KEY));
    } catch {
      return null;
    }
  };

  let gtagLoaded = false;
  function loadAnalytics() {
    gtag('consent', 'update', { analytics_storage: 'granted' });
    // Ne charge pas gtag tant que l'ID est le placeholder de dev
    if (gtagLoaded || gtagId.includes('XXXX')) return;
    gtagLoaded = true;
    const s = document.createElement('script');
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gtagId;
    s.async = true;
    document.head.appendChild(s);
    gtag('js', new Date());
    gtag('config', gtagId);
  }

  function clearAnalyticsCookies() {
    document.cookie.split(';').forEach((c) => {
      const name = c.split('=')[0].trim();
      if (name === '_ga' || name.startsWith('_ga_')) {
        document.cookie = name + '=; Max-Age=0; path=/';
        document.cookie = name + '=; Max-Age=0; path=/; domain=' + location.hostname;
      }
    });
  }

  function apply(analytics) {
    localStorage.setItem(KEY, JSON.stringify({ analytics, date: new Date().toISOString() }));
    banner.hidden = true;
    if (analytics === 'granted') {
      loadAnalytics();
    } else {
      gtag('consent', 'update', { analytics_storage: 'denied' });
      clearAnalyticsCookies();
    }
    select(analytics);
  }

  function select(analytics) {
    choices.forEach((btn) =>
      btn.setAttribute('aria-pressed', String(btn.dataset.cookieChoice === analytics))
    );
  }

  let selected = read()?.analytics ?? 'denied';
  select(selected);
  choices.forEach((btn) =>
    btn.addEventListener('click', () => {
      selected = btn.dataset.cookieChoice;
      select(selected);
    })
  );

  document
    .querySelectorAll('[data-cookie-open]')
    .forEach((el) => el.addEventListener('click', () => dialog.showModal()));
  dialog
    .querySelector('[data-cookie-close]')
    .addEventListener('click', () => dialog.close());
  dialog.querySelector('[data-cookie-save]').addEventListener('click', () => {
    apply(selected);
    dialog.close();
  });
  banner
    .querySelector('[data-cookie-accept]')
    .addEventListener('click', () => apply('granted'));
  banner
    .querySelector('[data-cookie-refuse]')
    .addEventListener('click', () => apply('denied'));

  const stored = read();
  if (!stored) banner.hidden = false;
  else if (stored.analytics === 'granted') loadAnalytics();

  if (location.hash === '#cookies') dialog.showModal();
</script>
